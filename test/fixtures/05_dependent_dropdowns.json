{
  "display": "form",
  "title": "Dependent Locations",
  "name": "dependentLocations",
  "components": [
    {
      "type": "select",
      "key": "country",
      "label": "Country",
      "dataSrc": "values",
      "data": {
        "values": [
          { "label": "United States", "value": "us" },
          { "label": "Canada", "value": "ca" },
          { "label": "France", "value": "fr" }
        ]
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "city",
      "label": "City",
      "dataSrc": "url",
      "data": {
        "url": "/api/cities"
      },
      "valueProperty": "id",
      "template": "<span>{{ item.label }}</span>",
      "validate": {
        "required": true
      }
    }
  ]
}
